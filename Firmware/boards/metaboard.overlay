
&clock {
	hfclkaudio-frequency = <12288000>;
};

&pinctrl {
	pdm0_default_alt: pdm0_default_alt {
		group1 {
			psels = <NRF_PSEL(PDM_CLK, 0, 11)>,
				<NRF_PSEL(PDM_DIN, 0, 7)>;
		};
	};

	spi0_default: spi0_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 8)>,
		   <NRF_PSEL(SPIM_MOSI, 0, 9)>,
		   <NRF_PSEL(SPIM_MISO, 0, 10)>;
		};
	};
};


dmic_dev: &pdm0 {
	status = "okay";
	pinctrl-0 = <&pdm0_default_alt>;
	pinctrl-names = "default";
	clock-source = "ACLK";
	// queue-size = <192>;
};


&uart0 {
	status = "disabled";
};

&button0 {
	gpios = <&gpio0 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
};

&button1 {
	gpios = <&gpio1 12 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
};

&button2 {
	status = "disabled";
};

&button3 {
	status = "disabled";
};

&spi4 {
	status = "disabled";
};

&spi0 {
	status = "okay";
	cs-gpios = <&gpio0 18 GPIO_ACTIVE_LOW>;
	pinctrl-0 = <&spi0_default>;
	pinctrl-names = "default";
	max-frequency = <DT_FREQ_M(3)>;

	bno085: bno08x@0 {
		status = "okay";
		compatible = "ceva,bno08x";
		reg = <0>;
		irq-gpios = <&gpio1 8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		wake-gpios = <&gpio1 6 0>;
		reset-gpios = <&gpio0 20 0>;
		spi-max-frequency = <DT_FREQ_M(3)>;
	};
};

&qspi {
	status = "disabled";
};

&led0 {
	label = "Red LED";
	gpios = <&gpio1 10 (GPIO_ACTIVE_LOW)>;
};

&led1 {
	label = "Green LED";
	gpios = <&gpio0 30 (GPIO_ACTIVE_LOW)>;
};

&led2 {
	label = "Blue LED";
	gpios = <&gpio0 31 (GPIO_ACTIVE_LOW)>;
};

&led3 {
	status = "disabled";
};

&gpio_fwd {
	uart {
		status = "disabled";
		gpios = <&gpio1 0 0>;
	};
};



/ {
	leds {
		imu_clk_sel_1:imu_clk_sel_1 {
			label = "imu_clk_sel_1";
			gpios = <&gpio0 21 GPIO_PULL_DOWN>;
		};
	};
};


&adc {
    status = "okay";
};

/ {
    zephyr,user {
        io-channels = <&adc 2>;  // AIN2 (P0.06)
    };
};

&adc {
    #address-cells = <1>;
    #size-cells = <0>;

    channel@2 {
        reg = <2>;
        zephyr,gain = "ADC_GAIN_1_6";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
        zephyr,input-positive = <NRF_SAADC_AIN2>;  // P0.06
        zephyr,resolution = <12>;
        zephyr,oversampling = <4>;
    };
};


&pinctrl {
    i2c1_default: i2c1_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 1, 2)>,   /* P1.02 */
                    <NRF_PSEL(TWIM_SCL, 1, 3)>;   /* P1.03 */
        };
    };

    i2c1_sleep: i2c1_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 1, 2)>,   /* P1.02 */
                    <NRF_PSEL(TWIM_SCL, 1, 3)>;   /* P1.03 */
            low-power-enable;
        };
    };
};

/* TWIM1 on P1.02 / P1.03 @ 400kHz */
&i2c1 {
    compatible = "nordic,nrf-twim";
    status = "okay";
    clock-frequency = <I2C_BITRATE_STANDARD>;
    pinctrl-0 = <&i2c1_default>;
    pinctrl-1 = <&i2c1_sleep>;
    pinctrl-names = "default", "sleep";

    /* DRV2605 at 0x5A with enable pin on P1.14 */
    haptic: drv2605@5a {
        compatible = "ti,drv2605";
        reg = <0x5a>;
        label = "DRV2605";
        en-gpios = <&gpio1 14 GPIO_ACTIVE_HIGH>;

        /* Optional tuning via DT (defaults chosen below): */
        ti,lra;                       /* comment out to use ERM */
        ti,rated-mv = <2000>;         /* rated voltage in mV (typical for LRA: 1.8-3.0V) */
        ti,od-clamp-mv = <3200>;      /* overdrive clamp in mV (typical: 2.5-3.6V) */
        ti,drive-time-tenth-ms = <25>;/* initial LRA half-period guess: 2.5ms */
        ti,auto-cal-time = <2>;       /* 0..3; 2 = 500–700ms */
        /* Note: If auto-cal fails, device may still work with default calibration.
         * Lower voltages if you see overdrive clamp errors (e.g., rated-mv = <1800>, od-clamp-mv = <2800>) */
    };
};
